# Copy to .env.local and fill in. Never commit the filled-in version.

# --- Supabase ---
# Project URL and anon key are public by design (the anon key is protected by row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key bypasses row-level security. Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Use sk_test_… until the whole payment flow has been verified end to end.
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint pointing at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Game server (Colyseus, deployed separately) ---
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567
